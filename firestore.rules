rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección de negocios - lectura pública, escritura autenticada
    match /negocios/{negocioId} {
      allow read: if true;
      allow write: if true; // Temporalmente abierto para inicialización
    }
    
    // Colección de mesas - lectura pública, escritura autenticada
    match /mesas/{mesaId} {
      allow read: if true;
      allow write: if true; // Temporalmente abierto para inicialización
    }
    
    // Colección de reservas - lectura y escritura pública (los clientes crean reservas)
    match /reservas/{reservaId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Colección de horarios - lectura pública
    match /horarios_apertura/{horarioId} {
      allow read: if true;
      allow write: if true; // Temporalmente abierto para inicialización
    }
    
    // Colección de emails (para Trigger Email Extension)
    match /mail/{mailId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Solo la extensión puede modificar
    }
  }
}
